		Formula formulaLocal;
		// final long hash;
		// final apostaAcerto itemApostaAcerto = new apostaAcerto();
		// final int itemEncontrado;
		// final int incremento = (estamosEmTeste ? 1 : 2);
		int percente = 0;
		final int fracao = (nReg - 10) / 10;
		/// System.setOut(console);
		System.out.println("\nInicio da apuração do ultimo sorteio nas formulas.( "
				+ format.format(GregorianCalendar.getInstance().getTime()) + " ).");
		final long t1 = System.currentTimeMillis();
		final byte[] sorteioAtual = listaOrdemSorteio.get(0);
		// final byte[] sorteioAtual = { 47, 27, 54, 23, 30, 51 };
		// baseHash = new long[61];
		final long hashSorteio = baseHash[sorteioAtual[0]] + baseHash[sorteioAtual[1]] + baseHash[sorteioAtual[2]]
				+ baseHash[sorteioAtual[3]] + baseHash[sorteioAtual[4]] + baseHash[sorteioAtual[5]];
		long tempHash;
		/// if (semNovoCalculo == false) {
		int senas = 0, quinas = 0, quadras = 0, ternos = 0, duplas = 0, solos = 0;
		for (int n = 0; n < nReg; n += 2) {
			if (n % fracao == 0 & n > 0) {
				percente += 10;
				System.out.println(
						"Processadas até o momento ( " + format.format(GregorianCalendar.getInstance().getTime())
								+ " ) aproximadamente " + percente + "% das fórmulas.");
				// System.out.println("\nForam computadas até o momento: " + String.format("%,d
				// senas, ", senas)
				// + String.format("%,d quinas e ", quinas) + String.format("%,d quadras.",
				// quadras));
			}
			item = rankCalibragemFinal.get(n);
			// if (item.numSorteiosComAcerto == 66) {
			// System.out.println("Ponto de analise");
			// }
			formulaLocal = new Formula(item.baseFormula);
			// aposta = SoProcessa.defineDezenas(formulaLocal, colecao, (byte) 10, indice);
			aposta = SoProcessa.defineDezenasUltra(formulaLocal, colecao);// , indice);
			for (byte comOuSemDarhak = 0; comOuSemDarhak < 2; comOuSemDarhak++) {
				// tempHash = geraHash(aposta[comOuSemDarhak]);
				/*
				 * ver 78 tempHash = baseHash[aposta[comOuSemDarhak][0]] +
				 * baseHash[aposta[comOuSemDarhak][1]] + baseHash[aposta[comOuSemDarhak][2]] +
				 * baseHash[aposta[comOuSemDarhak][3]];
				 */
				// + baseHash[aposta[comOuSemDarhak][4]] + baseHash[aposta[comOuSemDarhak][5]];
				// ver 78
				tempHash = geraHash(aposta[comOuSemDarhak]);
				long intersecao = hashSorteio & tempHash;
				if (intersecao == 0) {
					continue;
				}
				final int numeroDeAcertos = Long.bitCount(intersecao);

				// final int numeroDeAcertos = Long.bitCount(hashSorteio & tempHash);
				// if (numeroDeAcertos == 0) {
				// continue;
				// }
				switch (numeroDeAcertos) {
				case 1:
					solos++;
					break;
				case 2:
					duplas++;
					break;
				case 3:
					ternos++;
					break;
				case 4:
					quadras++;
					break;
				case 5:
					quinas++;
					break;
				default:
					senas++; // 6 ou mais (se aplicável)
				}

				/*
				 * ver 78 if ((hashSorteio & tempHash) != 0) { byte nAcertosInicial = 0; for
				 * (byte cursorSorteio = 0; cursorSorteio < 6; cursorSorteio++) { if
				 * (((baseHash[sorteioAtual[cursorSorteio]]) & tempHash) != 0) {
				 * nAcertosInicial++; } } byte nAcertosPriDezena = 0; for (int j = 4; j < 9;
				 * j++) { for (byte cursorSorteio = 0; cursorSorteio < 6; cursorSorteio++) { if
				 * (((baseHash[sorteioAtual[cursorSorteio]]) &
				 * baseHash[aposta[comOuSemDarhak][j]]) != 0) { nAcertosPriDezena = 1; break; }
				 * } for (int k = j + 1; k < 10; k++) { byte nAcertosSegDezena = 0; for (byte
				 * cursorSorteio = 0; cursorSorteio < 6; cursorSorteio++) { if
				 * (((baseHash[sorteioAtual[cursorSorteio]]) &
				 * baseHash[aposta[comOuSemDarhak][k]]) != 0) { nAcertosSegDezena = 1; break; }
				 * } final byte nAcertos = (byte) (nAcertosInicial + nAcertosPriDezena +
				 * nAcertosSegDezena); if (nAcertos > 3) { senas += (nAcertos == 6 ? 1 : 0);
				 * quinas += (nAcertos == 5 ? 1 : 0); quadras += (nAcertos == 4 ? 1 : 0); //
				 * //System.out.println( // " Estamos testando se a aposta " +
				 * Arrays.toString(aposta[comOuSemDarhak]) // + " no sorteio " +
				 * Arrays.toString(sorteioAtual)); //System.out.println("\nForam computadas : "
				 * + String.format("%,d senas, ", senas) // + String.format("%,d quinas e ",
				 * quinas) // + String.format("%,d quadras", quadras)); // } } } ///if
				 * ((sufixSorteio & tempHash) != 0) {
				 * //System.out.println(" Estamos testando se a aposta " +
				 * Arrays.toString(aposta[comOuSemDarhak]) // + " no sorteio " +
				 * Arrays.toString(sorteioAtual)); ///} }
				 */
				item = rankCalibragemFinal.get(n + 1);
			}
		}
		System.out.println("Final da apuracao do ultimo sorteio nas formulas. Executado em : " + getHMS(t1));
		resultados[0] = senas;
		resultados[1] = quinas;
		resultados[2] = quadras;
		System.out.println(
				"\nForam computadas : " + String.format("%,d senas, ", senas) + String.format("%,d quinas ", quinas)
						+ String.format("%,d quadras ", quadras) + String.format("%,d ternos ", ternos)
						+ String.format("%,d duplas e ", duplas) + String.format("%,d solos.", solos));
	}

