	public static void wait(final int s) {
		try {
			Thread.sleep(s * 1000);
		} catch (final InterruptedException ex) {
			Thread.currentThread().interrupt();
		}
	}

	private static void waitSorteio(final int sorteioParaAguardar) throws Exception {
		final DateTimeFormatter dtf = DateTimeFormatter.ofPattern("yyyy/MM/dd HH:mm:ss");
		LocalDateTime now;
		// System.setOut(console);
		System.out.println("\nAguardando chegada do sorteio " + sorteioParaAguardar + " .");
		int intervalo = 600;
		Calendar agora;
		int hora;
		while (true) {
			/// getSorteio();
			/// if (sorteioParaAguardar == numSorteio) {
			numSorteio = lastSorteio();
			if (sorteioParaAguardar == numSorteio) {
				break;
			}
			now = LocalDateTime.now();
			// System.out.println(dtf.format(now));
			agora = Calendar.getInstance();
			hora = agora.get(Calendar.HOUR_OF_DAY); // Hora no formato 24h
			if (numSorteio == 0) {
				System.out.println(dtf.format(now) + " Erro ao acessar o serviço da Caixa.");
				continue;
			}
			if (hora >= 20 && hora < 22) {
				// System.out.println("O horário atual está entre 20h e 21h");
				intervalo = 60;
			} else {
				// System.out.println("O horário atual NÃO está entre 20h e 21h");
				intervalo = 600;
			}
			System.out.println(dtf.format(now) + " Aguardando " + intervalo / 60
					+ " min para nova verificacao da chegada do sorteio " + sorteioParaAguardar
					+ ". O sorteio atual e o " + numSorteio);
			wait(intervalo);
		}
	}
    private static void prtCabecalho() {
    	final int maiorQtdDezenas = 10;
		final String preencheIguais = "=".repeat((maiorQtdDezenas * 3));
		final String preencheEspacos = " ".repeat((maiorQtdDezenas * 3));
    	System.out.println(
				"\n                                                                                                 Número   Qtd      Score"
						+ preencheEspacos + "");
		System.out.println(
				"Rank         Obtido    Investido      Resultado Senas Quinas Quadras Terno Duplas Solos   Filtro Sorteio  Ace      % Descrição       "
						+ (preencheEspacos + "  Números escolhidos").substring(18)
						+ " Código Fórmula => Fórmula utilizada para obtenção das dezenas indicadas");
		System.out.print(
				"==== ============== ============ ============== ===== ====== ======= ===== ====== ======= ====== ======= ===== ===== ================= "
						+ preencheIguais + " " +"================ "+ "=".repeat(226));
		return;
    }
    
	private static String determinarClassificacao(double score) {
		if (score >= 95)
			return "EXCEPCIONAL ★★★★★";
		if (score >= 85)
			return "EXCELENTE ★★★★   ";
		if (score >= 75)
			return "MUITO BOA ★★★    ";
		if (score >= 65)
			return "BOA ★★           ";
		if (score >= 50)
			return "REGULAR ★        ";
		return     "FRACA            ";
	}
}
