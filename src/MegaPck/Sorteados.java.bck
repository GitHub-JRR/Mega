	private static int getConcurso(final String url) {
		JSONObject jsonResponse = null;
		try {
			jsonResponse = getJsonFromUrl(url);
		} catch (final Exception e) {
			// TODO Auto-generated catch block
			e.printStackTrace();
		}
		return jsonResponse.getInt("numero");
	}

	public static String getHMS(long t1) {
		t1 = System.currentTimeMillis() - t1;
		return getHMSPuro(t1) + " (" + t1 + ")";
	}

	public static String getHMSPuro(long t1) {
		// t1 = System.currentTimeMillis() - t1;
		return String.format("%02d:%02d:%02d.%03d", TimeUnit.MILLISECONDS.toHours(t1),
				TimeUnit.MILLISECONDS.toMinutes(t1) - TimeUnit.HOURS.toMinutes(TimeUnit.MILLISECONDS.toHours(t1)),
				TimeUnit.MILLISECONDS.toSeconds(t1) - TimeUnit.MINUTES.toSeconds(TimeUnit.MILLISECONDS.toMinutes(t1)),
				t1 - (t1 / 1000) * 1000);
	}

	private static JSONObject getJsonFromUrl(final String url) throws Exception {
		// final HttpURLConnection connection = (HttpURLConnection) new
		// URL(url).openConnection();
		final HttpURLConnection connection = (HttpURLConnection) new URI(url).toURL().openConnection();
		connection.setRequestMethod("GET");
		final BufferedReader in = new BufferedReader(new InputStreamReader(connection.getInputStream()));
		String inputLine;
		final StringBuilder content = new StringBuilder();
		while ((inputLine = in.readLine()) != null) {
			content.append(inputLine);
		}
		in.close();
		connection.disconnect();
		return new JSONObject(content.toString());
	}

	private static String getSequencia(final String local, final String string) throws IOException {
		final FileFilter filter = file -> file.getName().startsWith(string) & file.getName().endsWith(".txt");
		final File dir = new File(local);
		final File[] files = dir.listFiles(filter);
		final int proximo = files.length + 1;
		final SimpleDateFormat formatoData = new SimpleDateFormat("_ddMMyyyy_HHmmss");
		formatoData.setTimeZone(TimeZone.getTimeZone("GMT-3:00"));
		final Calendar data = Calendar.getInstance();
		return local + "\\" + string + proximo + formatoData.format(data.getTime()) + ".txt";
	}
